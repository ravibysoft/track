    "apk:release": "vite build && cap sync android && android\\gradlew.bat -p android assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
