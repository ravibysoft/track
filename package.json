{
  "name": "track",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke": "vite build --ssr scripts/smoke.jsx --outDir .smoke --logLevel error && node .smoke/smoke.js",
